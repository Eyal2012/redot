{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build/redot-moved",
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/redot-moved",
        "--config",
        "Debug",
        "--target",
        "ReDot",
        "--parallel"
      ],
      "dependsOn": "CMake: Configure Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: Build Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/redot-moved",
        "--config",
        "Release",
        "--target",
        "ReDot",
        "--parallel"
      ],
      "dependsOn": "CMake: Configure Debug",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Verify: Quiet (Release)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tests/run_quiet_tests.ps1",
        "-BuildDirectory",
        "build/redot-moved"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
