#include <winres.h>
1 RT_MANIFEST "updater.manifest"
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "ReDot\0"
      VALUE "FileDescription", "ReDot Updater\0"
      VALUE "FileVersion", "1.0.0\0"
      VALUE "InternalName", "ReDotUpdater\0"
      VALUE "OriginalFilename", "ReDotUpdater.exe\0"
      VALUE "ProductName", "ReDot Updater\0"
      VALUE "ProductVersion", "1.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
